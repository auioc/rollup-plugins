{
    "name": "@auioc/rollup-plugin-sass",
    "version": "1.0.0",
    "description": "Rollup plugin - compile standalone sass/scss files",
    "keywords": [
        "rollup",
        "plugin",
        "rollup-plugin",
        "sass"
    ],
    "license": "MIT",
    "homepage": "https://github.com/auioc/rollup-plugins/tree/main/packages/sass",
    "repository": {
        "type": "git",
        "url": "https://github.com/auioc/rollup-plugins.git",
        "directory": "packages/sass"
    },
    "author": {
        "name": "AUIOC",
        "url": "https://auioc.org"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.cjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rollup -c"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "sass": "^1.108.1"
    }
}
